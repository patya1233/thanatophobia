local Button = b2c1Tab:CreateButton({
    Name = "Auto Burn",

    Callback = function()

        SaveCFrame()
        StartFloat()

        local MonsterPath = workspace:FindFirstChild("Monsters", true)
        local MonsterDistance = 30

        for _, v in ipairs(workspace.Section2.BurnPuzzle:GetChildren()) do

            if v:IsA("Model") and v.Name == "BurnLocation" then

                -- ถ้ามอนอยู่ใกล้จุดที่จะไป
                while MonsterPath
                    and IsMonsterNear(
                        MonsterPath,
                        v,
                        MonsterDistance
                    ) do

                    -- หลบกลับจุดเดิม
                    ReturnCFrame()
                    task.wait(0.2)
                end

                -- มอนออกแล้ว ค่อยไปทำต่อ
                TeleportTo(v)
                task.wait(0.3)

                -- เช็กอีกครั้งหลังวาป
                if MonsterPath
                    and IsMonsterNear(
                        MonsterPath,
                        v,
                        MonsterDistance
                    ) then

                    ReturnCFrame()

                    repeat
                        task.wait(0.2)
                    until not IsMonsterNear(
                        MonsterPath,
                        v,
                        MonsterDistance
                    )

                    TeleportTo(v)
                    task.wait(0.3)
                end

                local pp = v

                local prompt =
                    pp:FindFirstChildWhichIsA(
                        "ProximityPrompt",
                        true
                    )
                    or (
                        pp.Parent
                        and pp.Parent:FindFirstChildWhichIsA(
                            "ProximityPrompt",
                            true
                        )
                    )

                if prompt then
                    InteractPrompt(prompt, 0)
                end
            end
        end

        StopFloat()
        ReturnCFrame()
    end,
})

