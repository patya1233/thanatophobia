                    end

                    -- ไม่มีมอน → เข้าไปทำ
                    found = true

                    TeleportTo(v)
                    task.wait(0.3)

                    local prompt =
                        v:FindFirstChildWhichIsA("ProximityPrompt", true)
                        or (
                            v.Parent
                            and v.Parent:FindFirstChildWhichIsA(
                                "ProximityPrompt",
                                true
                            )
                        )

                    if prompt then
                        InteractPrompt(prompt, 0)
                    end

                    placed[v] = true

                    task.wait(0.1)
                end
            end


            -- ==========================================
            -- ตรวจว่ายังมี PlaceTrigger เหลือไหม
            -- ==========================================

