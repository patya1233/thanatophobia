        -- หา Folder/Model ชื่อ Monsters อัตโนมัติ
        -- ==========================================
        local MonsterPath = workspace:FindFirstChild("Monsters", true)
        local MonsterDistance = 30

        -- ==========================================
        -- Dialogue
        -- ==========================================
        for _, v in ipairs(workspace.Dialogue:GetChildren()) do
            if v:IsA("Part") then
                TeleportTo(v)
                task.wait(0.5)
            end
        end

        -- ==========================================
        -- Lever
        -- ==========================================
        for _, v in ipairs(workspace.GatePuzzle:GetChildren()) do

            if v.Name == "Lever" then

                local pp = v:FindFirstChild("Lever1")

                if pp then

                    -- ถ้ามอนอยู่ใกล้ → กลับจุดเดิมและรอ
                    while MonsterPath
                        and IsMonsterNear(
                            MonsterPath,
                            pp,
                            MonsterDistance
                        ) do

                        ReturnCFrame()
                        task.wait(0.2)
                    end

                    -- วาปไป Lever
                    TeleportTo(v)
                    task.wait(0.3)

                    -- เช็กมอนอีกครั้งหลังวาป
                    if MonsterPath
                        and IsMonsterNear(
                            MonsterPath,
                            pp,
                            MonsterDistance
                        ) then

                        ReturnCFrame()

                        repeat
                            task.wait(0.2)
                        until not IsMonsterNear(
                            MonsterPath,
                            pp,
                            MonsterDistance
                        )

                        TeleportTo(v)
                        task.wait(0.3)
                    end

                    local prompt =
                        pp:FindFirstChildWhichIsA(
                            "ProximityPrompt",
                            true
                        )
                        or (
                            pp.Parent
                            and pp.Parent:FindFirstChildWhichIsA(
                                "ProximityPrompt",
                                true
                            )
                        )

                    if prompt then
                        InteractPrompt(prompt, 0)
                    end
                end
            end
        end

        task.wait()

        TeleportTo(workspace.GameInfo.ExitPart)
    end,
})

