            local found = false

            for _, v in ipairs(workspace.MainPuzzle:GetChildren()) do

                if v:IsA("Part")
                    and v.Name == "PlaceTrigger"
                    and not placed[v] then

                    -- มีมอนอยู่ใกล้ → ข้ามก่อน
                    if IsMonsterNear(
                        MonsterPath,
                        v,
                        MonsterDistance
                    ) then
