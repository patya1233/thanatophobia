local function RemoveESP(object)
    if not object then return end

    -- ลบ Object ที่ชื่อมีคำว่า "Fackhub"
    for _, obj in ipairs(object:GetDescendants()) do
        if string.find(obj.Name, "Fackhub", 1, true) then
            obj:Destroy()
        end
    end

    -- เช็กตัว object เองด้วย
    if string.find(object.Name, "Fackhub", 1, true) then
        object:Destroy()
    end
end

local function CreateHighlight(object, fillColor, outlineColor, fillTrans, outlineTrans)
    if not object then return end
    if object:FindFirstChild("FackhubHighlight") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "FackhubHighlight"
    highlight.FillColor = fillColor or Color3.fromRGB(255, 255, 255)
    highlight.OutlineColor = outlineColor or Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = fillTrans or 0.5
    highlight.OutlineTransparency = outlineTrans or 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = object

    return highlight
end


-- 2. ฟังก์ชันสร้าง BillboardGui / ESP Text
local function CreateESPText(object, text, color, offset, size)
    if not object then return end
    if object:FindFirstChild("FackhubText") then return end

    color = color or Color3.fromRGB(255, 255, 255)
    offset = offset or Vector3.new(0, 3, 0)
    size = size or UDim2.new(0, 150, 0, 40)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "FackhubText"
    billboard.Size = size
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = offset
    billboard.Parent = object

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text or object.Name
    textLabel.TextColor3 = color
    textLabel.TextStrokeTransparency = 0
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = billboard

    return billboard
end


local function CreateESPBox(object, color, size, transparency)
    if not object then
        return nil
    end

    color = color or Color3.fromRGB(0, 255, 0)
    transparency = transparency or 0.5

    -- Part / MeshPart / UnionOperation ฯลฯ
    if object:IsA("BasePart") then
        if object:FindFirstChild("FackhubBox") then
            return nil
        end

        local box = Instance.new("BoxHandleAdornment")
        box.Name = "FackhubBox"
        box.Adornee = object
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Size = size or object.Size
        box.Color3 = color
        box.Transparency = transparency
        box.Parent = object

        return box
    end

    -- Model
    if object:IsA("Model") then
        local part = object:FindFirstChild("HumanoidRootPart")
            or object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)

        if not part then
            warn("ไม่พบ BasePart ใน Model:", object:GetFullName())
            return nil
        end

        if part:FindFirstChild("FackhubBox") then
            return nil
        end

        local box = Instance.new("BoxHandleAdornment")
        box.Name = "FackhubBox"
        box.Adornee = part
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Size = size or part.Size
        box.Color3 = color
        box.Transparency = transparency
        box.Parent = part

        return box
    end

    return nil
end

local function InteractPrompt(object, delayTime)
    if not object then return end

    local prompt = object

    if not object:IsA("ProximityPrompt") then
        prompt = object:FindFirstChild("ProximityPrompt", true)
    end

    if prompt and prompt:IsA("ProximityPrompt") then
        if delayTime and delayTime > 0 then
            task.wait(delayTime)
        end

        prompt.Enabled = true
        fireproximityprompt(prompt)
    end
end

local function TeleportTo(targetPosition)
    if hrp and targetPosition then
        if typeof(targetPosition) == "CFrame" then
            hrp.CFrame = targetPosition
        elseif typeof(targetPosition) == "Vector3" then
            hrp.CFrame = CFrame.new(targetPosition)
        elseif typeof(targetPosition) == "Instance"
            and targetPosition:IsA("BasePart") then
            hrp.CFrame = targetPosition.CFrame
        end
    end
end

local function TeleportToNearestSafeLight(folder)
    local nearest = nil
    local shortest = math.huge

    for _, v in ipairs(folder:GetChildren()) do
        if v:IsA("BasePart") then
            local distance = (hrp.Position - v.Position).Magnitude

            if distance < shortest then
                shortest = distance
                nearest = v
            end
        end
    end

    if nearest then
        TeleportTo(nearest)
    end
end

local AutoPickaxeConnection
local AutoPickaxeRunning = false

local function AutoPickaxe(Value)
    if Value then
        if AutoPickaxeRunning then
            return
        end

        AutoPickaxeRunning = true

        local Player = Players.LocalPlayer

        local Button = Player.PlayerGui
            :WaitForChild("PickaxeSequenceGUI")
            :WaitForChild("Frame")
            :WaitForChild("MainFrame")
            :WaitForChild("Button")

        local Ring = Button:WaitForChild("Ring")

        local fired = false
        local lastRingScale = nil

        -- ตรวจว่ามี Activated connection จริงไหม
        local connections = getconnections(Button.Activated)

        print("Activated connections:", #connections)

        for i, con in ipairs(connections) do
            print(
                i,
                "Enabled =", con.Enabled,
                "Function =", con.Function
            )
        end

        AutoPickaxeConnection = Ring:GetPropertyChangedSignal("Size"):Connect(function()
            if not AutoPickaxeRunning then
                return
            end

            if not Button.Visible then
                fired = false
                lastRingScale = nil
                return
            end

            local ringScale = Ring.Size.X.Scale

            -- วงถูกสร้างใหม่ / เริ่มรอบใหม่
            if ringScale >= 1.20 then
                fired = false
                lastRingScale = ringScale
                return
            end

            -- จับ "ข้าม" จาก > 1.0 ลงมา <= 1.0
            if not fired
                and lastRingScale ~= nil
                and lastRingScale > 1.0
                and ringScale <= 1.0 then

                fired = true

                print("AUTO PRESS:", Button.Text)
                print("Previous Ring:", lastRingScale)
                print("Current Ring :", ringScale)

                firesignal(Button.Activated)
            end

            lastRingScale = ringScale
        end)

        print("Auto Pickaxe : เปิด")

    else
        AutoPickaxeRunning = false

        if AutoPickaxeConnection then
            AutoPickaxeConnection:Disconnect()
            AutoPickaxeConnection = nil
        end

        print("Auto Pickaxe : ปิด")
    end
end

