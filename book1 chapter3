local Button = c3Tab:CreateButton({
    Name = "Auto lights the candle",

    Callback = function()

        SaveCFrame()

        local MonsterPath = workspace.Monsters
        local MonsterDistance = 20

        task.spawn(function()

            local Candles =
                workspace.MainPuzzle.CandlePuzzle.Candles

            local CandlesLit =
                workspace.MainPuzzle.CandlePuzzle.CandlesLit

            while CandlesLit.Value < 10 do

                local found = false

                -- ==========================================
                -- ไล่ Candle1 - Candle10
                -- ==========================================
                for i = 1, 10 do

                    -- ครบ 10 แล้ว → หยุดทันที
                    if CandlesLit.Value >= 10 then
                        break
                    end

                    local Candle =
                        Candles:FindFirstChild(
                            "Candle" .. i,
                            true
                        )

                    if Candle then

                        local Inter =
                            Candle:FindFirstChild(
                                "INTER",
                                true
                            )

                        if Inter then

                            -- มีมอนอยู่ใกล้ → ข้ามก่อน
                            if IsMonsterNear(
                                MonsterPath,
                                Inter,
                                MonsterDistance
                            ) then
                                continue
                            end

                            found = true

                            -- ==================================
                            -- วาปไปหา Candle
                            -- ==================================
                            TeleportTo(Inter)

                            task.wait(0.3)

                            -- ==================================
                            -- หา ProximityPrompt
                            -- ==================================
                            local prompt =
                                Inter:FindFirstChildWhichIsA(
                                    "ProximityPrompt",
                                    true
                                )

                            if not prompt and Inter.Parent then
                                prompt =
                                    Inter.Parent:FindFirstChildWhichIsA(
                                        "ProximityPrompt",
                                        true
                                    )
                            end

                            -- ==================================
                            -- กด Prompt
                            -- ==================================
                            if prompt then

                                prompt.Enabled = true

                                local BeforeLit =
                                    CandlesLit.Value

                                InteractPrompt(prompt, 0)

                                task.wait(0.1)

                                local AfterLit =
                                    CandlesLit.Value

                                -- จุดติดแล้ว
                                if AfterLit > BeforeLit then
                                    task.wait(0.1)
                                end
                            end
                        end
                    end
                end

                -- ==========================================
                -- ครบ 10 แล้ว
                -- ==========================================
                if CandlesLit.Value >= 10 then
                    break
                end

                -- ==========================================
                -- ยังไม่ครบ → กลับจุดเดิมแล้ววนใหม่
                -- ==========================================
                if found then
                    ReturnCFrame()
                    task.wait(0.1)
                else
                    ReturnCFrame()
                    task.wait(0.1)
                end
            end

            -- ==========================================
            -- จุดครบ 10 แล้ว
            -- ==========================================
            if CandlesLit.Value >= 10 then
                ReturnCFrame()
            end

        end)
    end,
})

