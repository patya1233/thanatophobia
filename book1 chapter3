            if yoshidaRoot then
                for i = 1, 2 do
                    TeleportTo(yoshidaRoot)
                    task.wait(0.5)
                end
            end
        end

        task.wait(1)

        -- Equip Lantern
        local lantern = backpack:FindFirstChild("Lantern")

        if lantern then
            humanoid:EquipTool(lantern)
        else
            warn("Lantern not found in backpack!")
