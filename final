local Button = fiTab:CreateButton({
    Name = "Auto Burn Cursed",

    Callback = function()

        StartFloat()

        local MainPuzzle = workspace.MainPuzzle
        local MonsterPath = workspace:FindFirstChild("Monsters", true)

        -- ระยะกันมอนเฉพาะ Cursed
        local CursedMonsterDistance = 30

        local SaitoHealth = MainPuzzle:WaitForChild("SaitoHealth")

        while SaitoHealth.Value > 0 do

            -- ==========================================
            -- 1. เก็บ Cursed
            -- ==========================================
            for _, v in ipairs(
                MainPuzzle.CursedFolder:GetChildren()
            ) do

                if v:IsA("Model") then

                    local pp = v:FindFirstChild("Cursed")

                    if pp then

                        -- กันมอนเฉพาะ Cursed
                        while MonsterPath
                            and IsMonsterNear(
                                MonsterPath,
                                pp,
                                CursedMonsterDistance
                            ) do

                            TeleportToNearestSafeLight(
                                workspace.SafeLanterns
                            )

                            task.wait(0.2)
                        end

                        TeleportTo(v)
                        task.wait(0.3)

                        local prompt =
                            pp:FindFirstChildWhichIsA(
                                "ProximityPrompt",
                                true
                            )
                            or (
                                pp.Parent
                                and pp.Parent:FindFirstChildWhichIsA(
                                    "ProximityPrompt",
                                    true
                                )
                            )

                        if prompt then
                            InteractPrompt(prompt, 0)
                        end
                    end
                end
            end

            -- ==========================================
            -- 2. BurnTrigger
            -- ไม่มีระบบหลบมอน
            -- ==========================================
            for _, v in ipairs(
                MainPuzzle:GetDescendants()
            ) do

                if v:IsA("BasePart") and v.Name == "BurnTrigger" then

                    TeleportTo(v)
                    task.wait(0.3)

                    local prompt =
                        v:FindFirstChildWhichIsA(
                            "ProximityPrompt",
                            true
                        )
                        or (
                            v.Parent
                            and v.Parent:FindFirstChildWhichIsA(
                                "ProximityPrompt",
                                true
                            )
                        )

                    if prompt then
                        InteractPrompt(prompt, 0)
                    end
                end
            end

            -- ==========================================
            -- 3. ทำครบแล้วค่อยเช็ก Health
            -- ==========================================
            task.wait()

            if SaitoHealth.Value <= 0 then
                break
            end
        end

        TeleportToNearestSafeLight(
            workspace.SafeLanterns
        )

        StopFloat()
    end,
})

