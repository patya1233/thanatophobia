local mTab = Window:Tab({
    Title = "Main",
    Icon = "align-justify",
})

local lighting = game:GetService("Lighting")

local OriginalLighting = {
    Ambient = lighting.Ambient,
    Brightness = lighting.Brightness,
    GlobalShadows = lighting.GlobalShadows,
    OutdoorAmbient = lighting.OutdoorAmbient
}

local OriginalSkies = {}

pcall(function()
    for _, v in ipairs(lighting:GetChildren()) do
        if v:IsA("Sky") then
            table.insert(OriginalSkies, v:Clone())
        end
    end
end)

-- ---------------------------------------------------------
-- Noclip
-- ---------------------------------------------------------

local NoclipSection = mTab:Section({
    Title = "Noclip",
    Opened = true,
})

Register("NoclipToggle", NoclipSection:Toggle({
    Title = "Noclip",
    Value = false,
    Flag = "NoclipToggle",

    Callback = Cb(function(Value)

        NoclipEnabled = Value

        if Value then
            StartNoclip()
        else
            StopNoclip()
        end

    end),
}))

-- ---------------------------------------------------------
-- Fly
-- ---------------------------------------------------------

local FlySection = mTab:Section({
    Title = "Fly",
    Opened = true,
})

Register("FlySpeedSlider", FlySection:Slider({
    Title = "Fly Speed",
    Step = 1,
    Value = {
        Min = 1,
        Max = 20,
        Default = 1,
    },
    Flag = "FlySpeedSlider",

    Callback = Cb(function(Value)

        FlySpeedValue = Value

    end),
}))

Register("FlyToggle", FlySection:Toggle({
    Title = "Fly",
    Desc = "W A S D = Move  |  Q = Down  |  E = Up",
    Value = false,
    Flag = "FlyToggle",

    Callback = Cb(function(Value)

        FlyEnabled = Value

        if Value then
            StartFly()
        else
            StopFly()
        end

    end),
}))

-- ---------------------------------------------------------
-- Lighting
-- ---------------------------------------------------------

local LightingSection = mTab:Section({
    Title = "Lighting",
    Opened = true,
})

Register("FulbrightToggle", LightingSection:Toggle({
    Title = "Fulbright",
    Value = false,
    Flag = "FulbrightToggle",

    Callback = Cb(function(Value)
        pcall(function()

            if Value then

                lighting.Ambient = Color3.fromRGB(255, 255, 255)
                lighting.Brightness = 10
                lighting.GlobalShadows = false
                lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)

                -- ลบ Sky ทั้งหมดจริง ๆ
                for _, v in ipairs(lighting:GetChildren()) do
                    if v:IsA("Sky") then
                        v:Destroy()
                    end
                end

            else

                -- คืนค่า Lighting
                lighting.Ambient = OriginalLighting.Ambient
                lighting.Brightness = OriginalLighting.Brightness
                lighting.GlobalShadows = OriginalLighting.GlobalShadows
                lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient

                -- ลบ Sky ที่เหลืออยู่
                for _, v in ipairs(lighting:GetChildren()) do
                    if v:IsA("Sky") then
                        v:Destroy()
                    end
                end

                -- คืน Sky เดิมทั้งหมด
                for _, SkyClone in ipairs(OriginalSkies) do
                    pcall(function()
                        SkyClone:Clone().Parent = lighting
                    end)
                end

            end

        end)
    end),
}))

