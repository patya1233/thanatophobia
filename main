local mTab = Window:CreateTab("Main", "align-justify")

local lighting = game:GetService("Lighting")

local OriginalLighting = {
    Ambient = lighting.Ambient,
    Brightness = lighting.Brightness,
    GlobalShadows = lighting.GlobalShadows,
    OutdoorAmbient = lighting.OutdoorAmbient
}

local lighting = game:GetService("Lighting")

local OriginalLighting = {
    Ambient = lighting.Ambient,
    Brightness = lighting.Brightness,
    GlobalShadows = lighting.GlobalShadows,
    OutdoorAmbient = lighting.OutdoorAmbient
}

local OriginalSkies = {}

pcall(function()
    for _, v in ipairs(lighting:GetChildren()) do
        if v:IsA("Sky") then
            table.insert(OriginalSkies, v:Clone())
        end
    end
end)

local Section = mTab:CreateSection("Noclip")

local NoclipToggle = mTab:CreateToggle({
    Name = "Noclip",
    CurrentValue = false,
    Flag = "NoclipToggle",

    Callback = function(Value)

        NoclipEnabled = Value

        if Value then
            StartNoclip()
        else
            StopNoclip()
        end

    end,
})

local Section = mTab:CreateSection("Fly")

local FlySpeedSlider = mTab:CreateSlider({
    Name = "Fly Speed",
    Range = {1, 20},
    Increment = 1,
    Suffix = "Speed",
    CurrentValue = 1,
    Flag = "FlySpeedSlider",

    Callback = function(Value)

        FlySpeedValue = Value

    end,
})

local FlyToggle = mTab:CreateToggle({
    Name = "Fly",
    CurrentValue = false,
    Flag = "FlyToggle",

    Callback = function(Value)

        FlyEnabled = Value

        if Value then
            StartFly()
        else
            StopFly()
        end

    end,
})

local Section = mTab:CreateSection("Lighting")

local Toggle = mTab:CreateToggle({
    Name = "Fulbright",
    CurrentValue = false,
    Flag = "FulbrightToggle",

    Callback = function(Value)
        pcall(function()

            if Value then

                lighting.Ambient = Color3.fromRGB(255, 255, 255)
                lighting.Brightness = 10
                lighting.GlobalShadows = false
                lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)

                -- ลบ Sky ทั้งหมดจริง ๆ
                for _, v in ipairs(lighting:GetChildren()) do
                    if v:IsA("Sky") then
                        v:Destroy()
                    end
                end

            else

                -- คืนค่า Lighting
                lighting.Ambient = OriginalLighting.Ambient
                lighting.Brightness = OriginalLighting.Brightness
                lighting.GlobalShadows = OriginalLighting.GlobalShadows
                lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient

                -- ลบ Sky ที่เหลืออยู่
                for _, v in ipairs(lighting:GetChildren()) do
                    if v:IsA("Sky") then
                        v:Destroy()
                    end
                end

                -- คืน Sky เดิมทั้งหมด
                for _, SkyClone in ipairs(OriginalSkies) do
                    pcall(function()
                        SkyClone:Clone().Parent = lighting
                    end)
                end

            end

        end)
    end,
})

local Section = mTab:CreateSection("Walk Speed")

local WalkSpeedSlider = mTab:CreateSlider({
    Name = "Walk Speed",
    Range = {16, 100},
    Increment = 1,
    Suffix = "Speed",
    CurrentValue = 16,
    Flag = "WalkSpeedSlider",

    Callback = function(Value)

        WalkSpeedValue = Value

        if WalkSpeedEnabled and Humanoid then
            Humanoid.WalkSpeed = Value
        end

    end,
})


