local settingTab = Window:CreateTab("Setting", "settings")

-- =========================================================
-- THEME
-- =========================================================

settingTab:CreateSection("Theme")

local ThemeDropdown = settingTab:CreateDropdown({
    Name = "Theme",

    Options = {
        "Default",
        "AmberGlow",
        "Amethyst",
        "Bloom",
        "DarkBlue",
        "Green",
        "Light",
        "Ocean",
        "Serenity"
    },

    CurrentOption = {"Default"},
    MultipleOptions = false,
    Flag = "SettingTheme",

    Callback = function(Options)
        local ThemeName = Options[1]

        if not ThemeName then
            return
        end

        pcall(function()
            Window.ModifyTheme(ThemeName)
        end)
    end
})

-- =========================================================
-- REPORT BUG
-- =========================================================

settingTab:CreateSection("Report Bug")

local BugDescription = ""

local BugInput = settingTab:CreateInput({
    Name = "Bug Description",
    CurrentValue = "",
    PlaceholderText = "Describe the bug...",
    RemoveTextAfterFocusLost = false,

    Callback = function(Text)
        BugDescription = Text
    end
})

-- =========================================================
-- GET REQUEST FUNCTION
-- Supports:
-- Real       -> request
-- Delta      -> http_request / request
-- Other      -> syn.request / http.request
-- =========================================================

local function GetRequestFunction()

    local RequestFunction = nil

    -- request
    pcall(function()
        local Loader = loadstring("return request")

        if Loader then
            local Success, Result = pcall(Loader)

            if Success and type(Result) == "function" then
                RequestFunction = Result
            end
        end
    end)

    if type(RequestFunction) == "function" then
        return RequestFunction
    end

    -- http_request
    pcall(function()
        local Loader = loadstring("return http_request")

        if Loader then
            local Success, Result = pcall(Loader)

            if Success and type(Result) == "function" then
                RequestFunction = Result
            end
        end
    end)

    if type(RequestFunction) == "function" then
        return RequestFunction
    end

    -- syn.request
    pcall(function()
        local Loader = loadstring("return syn and syn.request")

        if Loader then
            local Success, Result = pcall(Loader)

            if Success and type(Result) == "function" then
                RequestFunction = Result
            end
        end
    end)

    if type(RequestFunction) == "function" then
        return RequestFunction
    end

    -- http.request
    pcall(function()
        local Loader = loadstring("return http and http.request")

        if Loader then
            local Success, Result = pcall(Loader)

            if Success and type(Result) == "function" then
                RequestFunction = Result
            end
        end
    end)

    return RequestFunction
end

-- =========================================================
-- REPORT BUG BUTTON
-- =========================================================

local ReportBugButton = settingTab:CreateButton({
    Name = "Report Bug",

    Callback = function()

        -- =================================================
        -- YOUR NEW WEBHOOK
        -- =================================================

        local WebhookURL = "https://discord.com/api/webhooks/1557374256956833812/7F4wuVzPf8sqAsASpwHFRpXM3iR1_hbOsxORBw3z8AiqNMCAtMjWrbOZrmcvPe6LZkaa"

        if WebhookURL == ""
            or WebhookURL == "YOUR_NEW_WEBHOOK_HERE"
        then
            Rayfield:Notify({
                Title = "Report Bug",
                Content = "Webhook URL is not configured.",
                Duration = 5
            })

            return
        end

        -- =================================================
        -- CHECK DESCRIPTION
        -- =================================================

        local CleanText = BugDescription:gsub("%s+", "")

        if CleanText == "" then
            Rayfield:Notify({
                Title = "Report Bug",
                Content = "Please describe the bug first.",
                Duration = 5
            })

            return
        end

        -- Discord embed description limit
        local Description = BugDescription

        if #Description > 4000 then
            Description = Description:sub(1, 4000)
        end

        -- =================================================
        -- GET REQUEST
        -- =================================================

        local Request = GetRequestFunction()

        if type(Request) ~= "function" then

            Rayfield:Notify({
                Title = "Report Bug",
                Content = "HTTP request is unavailable.",
                Duration = 5
            })

            warn("[Fack HUB] No HTTP request function found.")

            return
        end

        -- =================================================
        -- SERVICES
        -- =================================================

        local Players = game:GetService("Players")
        local HttpService = game:GetService("HttpService")

        local LocalPlayer = Players.LocalPlayer

        -- =================================================
        -- WEBHOOK DATA
        -- =================================================

        local Data = {
            username = "Fack HUB Bug Reporter",

            embeds = {{
                title = "🐛 Fack HUB Bug Report",

                description = Description,

                fields = {
                    {
                        name = "Player",
                        value = LocalPlayer
                            and LocalPlayer.Name
                            or "Unknown",
                        inline = true
                    },

                    {
                        name = "User ID",
                        value = LocalPlayer
                            and tostring(LocalPlayer.UserId)
                            or "Unknown",
                        inline = true
                    },

                    {
                        name = "Place ID",
                        value = tostring(game.PlaceId),
                        inline = true
                    },

                    {
                        name = "Job ID",
                        value = tostring(game.JobId),
                        inline = false
                    }
                },

                footer = {
                    text = "Fack HUB Bug Reporter"
                },

                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        }

        -- =================================================
        -- ENCODE JSON
        -- =================================================

        local EncodeSuccess, Body = pcall(function()
            return HttpService:JSONEncode(Data)
        end)

        if not EncodeSuccess then

            Rayfield:Notify({
                Title = "Report Bug",
                Content = "Failed to encode report.",
                Duration = 5
            })

            return
        end

        -- =================================================
        -- SEND WEBHOOK
        -- =================================================

        local RequestSuccess, Response = pcall(function()
            return Request({
                Url = WebhookURL,

                Method = "POST",

                Headers = {
                    ["Content-Type"] = "application/json"
                },

                Body = Body
            })
        end)

        -- =================================================
        -- REQUEST ERROR
        -- =================================================

        if not RequestSuccess then

            warn(
                "[Fack HUB] Webhook Request Error:",
                tostring(Response)
            )

            Rayfield:Notify({
                Title = "Report Bug",
                Content = "Failed to send report.",
                Duration = 5
            })

            return
        end

        -- =================================================
        -- CHECK RESPONSE
        -- =================================================

        local StatusCode = nil
        local ResponseBody = nil

        if type(Response) == "table" then
            StatusCode = Response.StatusCode
            ResponseBody = Response.Body
        end

        print(
            "[Fack HUB] Webhook Status:",
            tostring(StatusCode)
        )

        if ResponseBody then
            print(
                "[Fack HUB] Webhook Response:",
                tostring(ResponseBody)
            )
        end

        -- =================================================
        -- SUCCESS
        -- =================================================

        if StatusCode == 200 or StatusCode == 204 then

            Rayfield:Notify({
                Title = "Report Bug",
                Content = "Bug report sent successfully.",
                Duration = 4
            })

            BugDescription = ""

            BugInput:Set("")

        -- =================================================
        -- FAILED
        -- =================================================

        else

            warn(
                "[Fack HUB] Webhook Failed | Status:",
                tostring(StatusCode),
                "| Response:",
                tostring(ResponseBody)
            )

            Rayfield:Notify({
                Title = "Report Bug",
                Content = "Webhook failed: " .. tostring(StatusCode),
                Duration = 6
            })
        end
    end
})

Rayfield:LoadConfiguration()
