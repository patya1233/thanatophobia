    Name = "Enable Walk Speed",
    CurrentValue = false,
    Flag = "WalkSpeedToggle",

    Callback = function(Value)

        WalkSpeedEnabled = Value

        if not Humanoid then
            return
        end

        if Value then

            Humanoid.WalkSpeed = WalkSpeedValue

        else

            Humanoid.WalkSpeed = OriginalWalkSpeed

        end

    end,
})

