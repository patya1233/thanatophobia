-- =========================================================
-- COMPATIBILITY LAYER (Rayfield API -> WindUI)
-- ให้สคริปต์ภายนอก (load all book 1-2) ที่เรียก
-- getgenv().FackWindowm:CreateTab(...) ยังใช้งานได้เหมือนเดิม
-- =========================================================

local function WrapElement(Element)

    local Wrapper = {}

    function Wrapper:Set(Value)
        pcall(function()
            if Element.Set then
                Element:Set(Value)
            elseif Element.Select then
                Element:Select(Value)
            end
        end)
    end

    function Wrapper:Refresh(...)
        pcall(Element.Refresh, Element, ...)
    end

    function Wrapper:Destroy()
        pcall(function()
            Element:Destroy()
        end)
    end

    Wrapper.Element = Element

    return setmetatable(Wrapper, {
        __index = function(_, Key)
            local Value = Element and Element[Key]

            if type(Value) == "function" then
                return function(_, ...)
                    return Value(Element, ...)
                end
            end

            return Value
        end
    })
end

local function MakeTabAdapter(WindTab)

    local Adapter = {}
    local Container = WindTab

    function Adapter:CreateSection(Name)

        local Ok, Section = pcall(function()
            return WindTab:Section({
                Title = tostring(Name),
                Opened = true,
            })
        end)

        if Ok and Section then
            Container = Section
        end

        return {
            Set = function(_, NewName)
                pcall(function()
                    Section:SetTitle(tostring(NewName))
                end)
            end
        }
    end

    function Adapter:CreateDivider()
        pcall(function()
            Container:Divider()
        end)
    end

    function Adapter:CreateLabel(Text)

        local Element = Container:Paragraph({
            Title = tostring(type(Text) == "table" and Text.Name or Text),
        })

        return WrapElement(Element)
    end

    function Adapter:CreateParagraph(Options)

        local Element = Container:Paragraph({
            Title = tostring(Options.Title or ""),
            Desc = tostring(Options.Content or ""),
        })

        return WrapElement(Element)
    end

    function Adapter:CreateButton(Options)

        local Element = Container:Button({
            Title = tostring(Options.Name or "Button"),
            Callback = function()
                local Ok, Err = pcall(Options.Callback or function() end)

                if not Ok then
                    warn("[Fack HUB] Button Error:", tostring(Err))
                end
            end,
        })

        return WrapElement(Element)
    end

    function Adapter:CreateToggle(Options)

        local Element = Container:Toggle({
            Title = tostring(Options.Name or "Toggle"),
            Value = Options.CurrentValue == true,
            Flag = Options.Flag,
            Callback = Cb(Options.Callback or function() end),
        })

        if Options.Flag then
            Register(Options.Flag, Element)
        end

        return WrapElement(Element)
    end

    function Adapter:CreateSlider(Options)

        local Range = Options.Range or {0, 100}

        local Element = Container:Slider({
            Title = tostring(Options.Name or "Slider"),
            Step = Options.Increment or 1,
            Value = {
                Min = Range[1],
                Max = Range[2],
                Default = Options.CurrentValue or Range[1],
            },
            Flag = Options.Flag,
            Callback = Cb(Options.Callback or function() end),
        })

        if Options.Flag then
            Register(Options.Flag, Element)
        end

        return WrapElement(Element)
    end

    function Adapter:CreateDropdown(Options)

        local Multi = Options.MultipleOptions == true
        local Current = Options.CurrentOption or {}

        if type(Current) ~= "table" then
            Current = {Current}
        end

        local UserCallback = Options.Callback or function() end

        local Element = Container:Dropdown({
            Title = tostring(Options.Name or "Dropdown"),
            Values = Options.Options or {},
            Value = Multi and Current or Current[1],
            Multi = Multi,
            AllowNone = true,
            Flag = Options.Flag,
            Callback = Cb(function(Option)

                -- Rayfield ส่งเป็น table เสมอ
                if type(Option) ~= "table" then
                    Option = {Option}
                end

                UserCallback(Option)

            end),
        })

        if Options.Flag then
            Register(Options.Flag, Element)
        end

        return WrapElement(Element)
    end

    function Adapter:CreateInput(Options)

        local Element = Container:Input({
            Title = tostring(Options.Name or "Input"),
            Value = tostring(Options.CurrentValue or ""),
            Placeholder = tostring(Options.PlaceholderText or ""),
            Flag = Options.Flag,
            Callback = Cb(Options.Callback or function() end),
        })

        if Options.Flag then
            Register(Options.Flag, Element)
        end

        return WrapElement(Element)
    end

    function Adapter:CreateKeybind(Options)

        local Element = Container:Keybind({
            Title = tostring(Options.Name or "Keybind"),
            Value = Options.CurrentKeybind or "E",
            Flag = Options.Flag,
            Callback = Cb(Options.Callback or function() end),
        })

        if Options.Flag then
            Register(Options.Flag, Element)
        end

        return WrapElement(Element)
    end

    function Adapter:CreateColorPicker(Options)

        local Element = Container:Colorpicker({
            Title = tostring(Options.Name or "Color"),
            Default = Options.Color or Color3.fromRGB(255, 255, 255),
            Flag = Options.Flag,
            Callback = Cb(Options.Callback or function() end),
        })

        if Options.Flag then
            Register(Options.Flag, Element)
        end

        return WrapElement(Element)
    end

    -- ให้เรียกคำสั่ง WindUI ตรง ๆ ได้ด้วย
    return setmetatable(Adapter, {
        __index = function(_, Key)
            local Value = WindTab[Key]

            if type(Value) == "function" then
                return function(_, ...)
                    return Value(WindTab, ...)
                end
            end

            return Value
        end
    })
end

local CompatWindow = {}

function CompatWindow:CreateTab(Name, Icon)

    local WindTab = Window:Tab({
        Title = tostring(Name),
        Icon = Icon,
    })

    return MakeTabAdapter(WindTab)
end

function CompatWindow:ModifyTheme(ThemeName)
    pcall(function()
        WindUI:SetTheme(ThemeName)
    end)
end

setmetatable(CompatWindow, {
    __index = function(_, Key)
        local Value = Window[Key]

        if type(Value) == "function" then
            return function(_, ...)
                return Value(Window, ...)
            end
        end

        return Value
    end
})

-- Rayfield-style object สำหรับสคริปต์ภายนอก
local RayfieldCompat = {
    Flags = {},
}

function RayfieldCompat:Notify(Options)
    Notify(
        Options.Title or "Fack HUB",
        Options.Content or "",
        Options.Duration or 5
    )
end

pcall(function()
    getgenv().FackWindowm = CompatWindow
    getgenv().FackWindow = Window
    getgenv().FackWindUI = WindUI
    getgenv().FackRayfield = RayfieldCompat
end)

