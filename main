-- =========================================================
-- FACK HUB | WindUI Version
-- Converted from Rayfield -> WindUI (v1.6.x)
-- =========================================================

local WindUI

do
    local Success, Result = pcall(function()
        return loadstring(game:HttpGet(
            "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
        ))()
    end)

    if not Success or not Result then
        warn("[Fack HUB] Failed to load WindUI:", tostring(Result))
        return
    end

    WindUI = Result
end

local Window = WindUI:CreateWindow({
    Title = "Fack HUB",
    Icon = "ghost", -- lucide icon
    Author = "Thanatophobia  •  by KENG",
    Folder = "FackHUB",

    Size = UDim2.fromOffset(580, 460),
    MinSize = Vector2.new(560, 350),
    MaxSize = Vector2.new(850, 560),
    ToggleKey = Enum.KeyCode.K,
    Transparent = true,
    Theme = "Dark",
    Resizable = true,
    SideBarWidth = 200,
    HideSearchBar = false,
    ScrollBarEnabled = true,
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local LocalPlayer = Players.LocalPlayer

-- ========================================
-- Config (แทน Rayfield ConfigurationSaving)
-- ========================================

local ConfigManager = Window.ConfigManager
local MainConfig = ConfigManager:CreateConfig("FackHUB")

local ConfigReady = false
local SavePending = false

local function QueueSave()

    if not ConfigReady or SavePending then
        return
    end

    SavePending = true

    task.delay(1, function()
        SavePending = false

        pcall(function()
            MainConfig:Save()
        end)
    end)
end

local function Register(Flag, Element)
    pcall(function()
        MainConfig:Register(Flag, Element)
    end)

    return Element
end

-- ครอบ Callback ให้ pcall + auto save
local function Cb(Func)
    return function(...)
        local Ok, Err = pcall(Func, ...)

        if not Ok then
            warn("[Fack HUB] Callback Error:", tostring(Err))
        end

        QueueSave()
    end
end

-- ========================================
-- Notify
-- ========================================

local function Notify(Title, Content, Duration)
    pcall(function()
        WindUI:Notify({
            Title = Title,
            Content = Content,
            Duration = Duration or 5,
            Icon = "bell",
        })
    end)
end

-- ========================================
-- Shared Character
-- ========================================

local Character = nil
local Humanoid = nil

-- ========================================
-- Original Values
-- ========================================

local OriginalWalkSpeed = 16
local OriginalJumpPower = 50
local OriginalJumpHeight = 7.2
local OriginalUseJumpPower = true

-- ========================================
-- Walk Speed
-- ========================================

local WalkSpeedEnabled = false
local WalkSpeedValue = 16

-- ========================================
-- Jump Power
-- ========================================

local JumpPowerEnabled = false
local JumpPowerValue = 50

-- ========================================
-- TPWalk
-- ========================================

local TPWalkEnabled = false
local TPWalkSpeed = 1
local TPWalkingConnection = nil

-- ========================================
-- Float
-- ========================================

local FloatEnabled = false
local FloatPart = nil
local FloatLoop = nil

-- ระยะห่างระหว่างตัวละครกับแผ่น Float
local FloatOffset = -3.1

-- ========================================
-- Instant Proximity Prompt
-- ========================================

local InstantPromptEnabled = false
local InstantPromptConnection = nil

-- Prompt ที่เคยปรับแล้ว
local ModifiedPrompts = setmetatable({}, {__mode = "k"})

local NoclipEnabled = false
local NoclipConnection = nil
local NoclipOriginalStates = {}

-- ========================================
-- Fly
-- ========================================

local FlyEnabled = false
local FlySpeedValue = 1

local FlyConnection = nil
local FlyInputBegan = nil
local FlyInputEnded = nil

local FlyBodyVelocity = nil
local FlyBodyGyro = nil

local FlyControls = {
    W = 0,
    A = 0,
    S = 0,
    D = 0,
    Q = 0,
    E = 0
}

-- ========================================
-- Setup Character
-- ========================================

local function SetupCharacter(NewCharacter)

    Character = NewCharacter
    Humanoid = Character:WaitForChild("Humanoid")

    -- จำค่าจริงจากตัวละครใหม่
    OriginalWalkSpeed = Humanoid.WalkSpeed
    OriginalJumpPower = Humanoid.JumpPower
    OriginalJumpHeight = Humanoid.JumpHeight
    OriginalUseJumpPower = Humanoid.UseJumpPower

    -- Walk Speed
    if WalkSpeedEnabled then
        Humanoid.WalkSpeed = WalkSpeedValue
    end

    -- Jump Power
    if JumpPowerEnabled then

        if Humanoid.UseJumpPower then
            Humanoid.JumpPower = JumpPowerValue
        else
            Humanoid.JumpHeight = JumpPowerValue
        end

    end
end


-- ========================================
-- Current Character
-- ========================================

if LocalPlayer.Character then
    SetupCharacter(LocalPlayer.Character)
end


-- ========================================
-- TPWalk Start
-- ========================================

local function StartTPWalk()

    if TPWalkingConnection then
        TPWalkingConnection:Disconnect()
        TPWalkingConnection = nil
    end

    if not Character or not Humanoid then
        return
    end

    TPWalkingConnection = RunService.Heartbeat:Connect(function(delta)

        if not TPWalkEnabled then
            return
        end

        if not Character or not Character.Parent then
            return
        end

        if not Humanoid or not Humanoid.Parent then
            return
        end

        if Humanoid.Health <= 0 then
            return
        end

        if Humanoid.MoveDirection.Magnitude > 0 then

            Character:TranslateBy(
                Humanoid.MoveDirection
                * TPWalkSpeed
                * delta
                * 10
            )

        end

    end)
end


-- ========================================
-- TPWalk Stop
-- ========================================

local function StopTPWalk()

    if TPWalkingConnection then
        TPWalkingConnection:Disconnect()
        TPWalkingConnection = nil
    end

end


-- ========================================
-- Remove Float Part
-- ========================================

local function RemoveFloatPart()
    if FloatPart then
        FloatPart:Destroy()
        FloatPart = nil
    end
end


-- ========================================
-- Stop Float
-- ========================================

local function StopFloat()

    FloatEnabled = false

    if FloatLoop then
        FloatLoop:Disconnect()
        FloatLoop = nil
    end

    RemoveFloatPart()
end


-- ========================================
-- Start Float
-- ========================================

local function StartFloat()

    -- เคลียร์ของเก่าก่อนทุกครั้ง
    if FloatLoop then
        FloatLoop:Disconnect()
        FloatLoop = nil
    end

    RemoveFloatPart()

    if not Character or not Character.Parent then
        return
    end

    Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    FloatEnabled = true

    -- สร้างแผ่น Float ใหม่
    FloatPart = Instance.new("Part")
    FloatPart.Name = "FackHubFloat"
    FloatPart.Size = Vector3.new(2.5, 0.2, 2.5)
    FloatPart.Transparency = 1
    FloatPart.Anchored = true
    FloatPart.CanCollide = true
    FloatPart.CanTouch = false
    FloatPart.CanQuery = false
    FloatPart.Parent = workspace

    -- วางครั้งแรก
    FloatPart.CFrame =
        Root.CFrame * CFrame.new(0, FloatOffset, 0)

    -- ให้แผ่นตามตัวละคร
    FloatLoop = RunService.Heartbeat:Connect(function()

        if not FloatEnabled then
            return
        end

        if not Character or not Character.Parent then
            return
        end

        if not Humanoid or not Humanoid.Parent then
            return
        end

        if Humanoid.Health <= 0 then
            return
        end

        local CurrentRoot =
            Character:FindFirstChild("HumanoidRootPart")

        if CurrentRoot and FloatPart then
            FloatPart.CFrame =
                CurrentRoot.CFrame
                * CFrame.new(0, FloatOffset, 0)
        end

    end)
end


-- ========================================
-- Instant Proximity Start
-- ========================================

local function StartInstantProximity()

    if InstantPromptConnection then
        InstantPromptConnection:Disconnect()
        InstantPromptConnection = nil
    end

    InstantPromptConnection =
        ProximityPromptService.PromptShown:Connect(function(prompt)

            if not InstantPromptEnabled then
                return
            end

            -- ปรับแล้วไม่ต้องปรับซ้ำ
            if ModifiedPrompts[prompt] then
                return
            end

            pcall(function()

                prompt.HoldDuration = 0

                ModifiedPrompts[prompt] = true

            end)

        end)
end


-- ========================================
-- Instant Proximity Stop
-- ========================================

local function StopInstantProximity()

    if InstantPromptConnection then
        InstantPromptConnection:Disconnect()
        InstantPromptConnection = nil
    end

end

-- ========================================
-- Start Noclip
-- ========================================

local function StartNoclip()

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if not Character then
        return
    end

    NoclipOriginalStates = {}

    NoclipConnection = RunService.Stepped:Connect(function()

        if not NoclipEnabled then
            return
        end

        if not Character or not Character.Parent then
            return
        end

        for _, Part in ipairs(Character:GetDescendants()) do

            if Part:IsA("BasePart") then

                if NoclipOriginalStates[Part] == nil then
                    NoclipOriginalStates[Part] = Part.CanCollide
                end

                if Part.CanCollide then
                    Part.CanCollide = false
                end

            end

        end

    end)
end


-- ========================================
-- Stop Noclip
-- ========================================

local function StopNoclip()

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    for Part, OriginalValue in pairs(NoclipOriginalStates) do

        if typeof(Part) == "Instance"
            and Part:IsA("BasePart")
            and Part.Parent then

            Part.CanCollide = OriginalValue

        end

    end

    NoclipOriginalStates = {}

end

-- ========================================
-- Stop Fly
-- ========================================

local function StopFly()

    FlyEnabled = false

    if FlyInputBegan then
        FlyInputBegan:Disconnect()
        FlyInputBegan = nil
    end

    if FlyInputEnded then
        FlyInputEnded:Disconnect()
        FlyInputEnded = nil
    end

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if FlyBodyVelocity then
        FlyBodyVelocity:Destroy()
        FlyBodyVelocity = nil
    end

    if FlyBodyGyro then
        FlyBodyGyro:Destroy()
        FlyBodyGyro = nil
    end

    if Humanoid and Humanoid.Parent then
        Humanoid.PlatformStand = false
    end

    table.clear(FlyControls)

    FlyControls = {
        W = 0,
        A = 0,
        S = 0,
        D = 0,
        Q = 0,
        E = 0
    }

    pcall(function()
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    end)

end


-- ========================================
-- Start Fly
-- ========================================

local function StartFly()

    StopFly()

    if not Character or not Character.Parent then
        return
    end

    Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    FlyEnabled = true

    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyGyro.Name = "FackHubFlyGyro"
    FlyBodyGyro.P = 90000
    FlyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    FlyBodyGyro.CFrame = Root.CFrame
    FlyBodyGyro.Parent = Root

    FlyBodyVelocity = Instance.new("BodyVelocity")
    FlyBodyVelocity.Name = "FackHubFlyVelocity"
    FlyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    FlyBodyVelocity.Velocity = Vector3.zero
    FlyBodyVelocity.Parent = Root


    -- ====================================
    -- Keyboard Input
    -- ====================================

    FlyInputBegan = UserInputService.InputBegan:Connect(function(Input, Processed)

        if Processed or not FlyEnabled then
            return
        end

        if Input.KeyCode == Enum.KeyCode.W then
            FlyControls.W = 1

        elseif Input.KeyCode == Enum.KeyCode.S then
            FlyControls.S = -1

        elseif Input.KeyCode == Enum.KeyCode.A then
            FlyControls.A = -1

        elseif Input.KeyCode == Enum.KeyCode.D then
            FlyControls.D = 1

        elseif Input.KeyCode == Enum.KeyCode.E then
            FlyControls.E = 1

        elseif Input.KeyCode == Enum.KeyCode.Q then
            FlyControls.Q = -1
        end

    end)


    FlyInputEnded = UserInputService.InputEnded:Connect(function(Input, Processed)

        if Processed then
            return
        end

        if Input.KeyCode == Enum.KeyCode.W then
            FlyControls.W = 0

        elseif Input.KeyCode == Enum.KeyCode.S then
            FlyControls.S = 0

        elseif Input.KeyCode == Enum.KeyCode.A then
            FlyControls.A = 0

        elseif Input.KeyCode == Enum.KeyCode.D then
            FlyControls.D = 0

        elseif Input.KeyCode == Enum.KeyCode.E then
            FlyControls.E = 0

        elseif Input.KeyCode == Enum.KeyCode.Q then
            FlyControls.Q = 0
        end

    end)


    -- ====================================
    -- Fly Loop
    -- ====================================

    FlyConnection = RunService.RenderStepped:Connect(function()

        if not FlyEnabled then
            return
        end

        if not Character or not Character.Parent then
            return
        end

        if not Humanoid or Humanoid.Health <= 0 then
            return
        end

        local CurrentRoot =
            Character:FindFirstChild("HumanoidRootPart")

        if not CurrentRoot then
            return
        end

        if not FlyBodyVelocity or not FlyBodyGyro then
            return
        end

        local Camera = workspace.CurrentCamera

        if not Camera then
            return
        end

        local Direction =
            (Camera.CFrame.LookVector
                * (FlyControls.W + FlyControls.S))

            + (Camera.CFrame.RightVector
                * (FlyControls.A + FlyControls.D))

            + (Vector3.new(0, 1, 0)
                * (FlyControls.Q + FlyControls.E))

        local Speed = FlySpeedValue * 50

        if Direction.Magnitude > 0 then
            FlyBodyVelocity.Velocity =
                Direction.Unit * Speed
        else
            FlyBodyVelocity.Velocity = Vector3.zero
        end

        FlyBodyGyro.CFrame = Camera.CFrame

        Humanoid.PlatformStand = true

    end)
end

-- ========================================
-- Character Respawn
-- ========================================

LocalPlayer.CharacterAdded:Connect(function(NewCharacter)

    SetupCharacter(NewCharacter)

    task.wait(0.2)

    if TPWalkEnabled then
        StartTPWalk()
    end

    if FloatEnabled then
        StartFloat()
    end

    if NoclipEnabled then
        StartNoclip()
    end

    if FlyEnabled then
        StartFly()
    end

end)

