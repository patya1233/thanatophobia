local settingTab = Window:Tab({
    Title = "Setting",
    Icon = "settings",
})

-- =========================================================
-- THEME
-- =========================================================

local ThemeSection = settingTab:Section({
    Title = "Theme",
    Opened = true,
})

-- แปลงชื่อธีมเดิมของ Rayfield -> ธีมของ WindUI
local ThemeMap = {
    Default   = "Dark",
    AmberGlow = "Amber",
    Amethyst  = "Violet",
    Bloom     = "Rose",
    DarkBlue  = "Midnight",
    Green     = "Emerald",
    Light     = "Light",
    Ocean     = "Sky",
    Serenity  = "Plant",
}

local function ApplyTheme(Name)

    local Target = ThemeMap[Name] or Name

    local Applied = pcall(function()
        local Themes = WindUI:GetThemes()

        if type(Themes) == "table" and Themes[Target] == nil then
            error("theme not found")
        end

        WindUI:SetTheme(Target)
    end)

    if not Applied then
        pcall(function()
            WindUI:SetTheme("Dark")
        end)
    end
end

Register("SettingTheme", ThemeSection:Dropdown({
    Title = "Theme",
    Values = {
        "Default",
        "AmberGlow",
        "Amethyst",
        "Bloom",
        "DarkBlue",
        "Green",
        "Light",
        "Ocean",
        "Serenity"
    },
    Value = "Default",
    Multi = false,
    AllowNone = false,
    Flag = "SettingTheme",

    Callback = Cb(function(Option)

        local ThemeName = Option

        if type(Option) == "table" then
            ThemeName = Option[1]
        end

        if not ThemeName then
            return
        end

        ApplyTheme(ThemeName)
    end),
}))

