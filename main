local BugSection = settingTab:Section({
    Title = "🐛 Report Bug",
    Opened = true,
})

local BugDescription = ""
local IsSendingBugReport = false

local ScriptVersion = "1.0"
local BugWebhookURL = "https://discord.com/api/webhooks/1557395558740787331/YerhCWdqJ6VRk6B8heAjv6vVGnh-lN8LJb9RjCkrlrGK2N0Iw_JSeif-KFpl2ddQytNE"

-- =========================================================
-- BUG DESCRIPTION INPUT
-- =========================================================

local BugInput = BugSection:Input({
    Title = "Bug Description",
    Value = "",
    Type = "Textarea",
    Placeholder = "Describe the bug...",

    Callback = function(Text)
        BugDescription = tostring(Text or "")
    end
})

-- =========================================================
-- GET REQUEST FUNCTION
-- Supports request, http_request, syn.request, http.request
-- =========================================================

local function GetRequestFunction()

    local RequestFunction = nil

    local Candidates = {
        "return request",
        "return http_request",
        "return syn and syn.request",
        "return http and http.request"
    }

    for _, Source in ipairs(Candidates) do
        pcall(function()
            local Loader = loadstring(Source)

            if Loader then
                local Success, Result = pcall(Loader)

                if Success and type(Result) == "function" then
                    RequestFunction = Result
                end
            end
        end)

        if type(RequestFunction) == "function" then
            return RequestFunction
        end
    end

    return nil
end

-- =========================================================
-- HELPER FUNCTIONS
-- =========================================================

local function NotifyBugReport(Content, Duration)
    Notify("Fack HUB | Report Bug", Content, Duration or 5)
end

-- Truncate text safely for UTF-8
local function LimitUTF8(Text, MaxCharacters)
    local Success, Length = pcall(function()
        return utf8.len(Text)
    end)

    if Success and Length and Length > MaxCharacters then
        local Position = utf8.offset(Text, MaxCharacters + 1)

        if Position then
            return Text:sub(1, Position - 1)
        end
    end

    return Text
end

-- =========================================================
-- REPORT BUG BUTTON
-- =========================================================

local ReportBugButton = BugSection:Button({
    Title = "🐛 Submit Bug Report",

    Callback = function()

        -- Prevent duplicate submissions
        if IsSendingBugReport then
            NotifyBugReport("A report is already being sent.", 4)
            return
        end

        -- =================================================
        -- CHECK WEBHOOK
        -- =================================================

        if BugWebhookURL == ""
            or BugWebhookURL == "YOUR_NEW_WEBHOOK_HERE"
        then
            NotifyBugReport("Webhook URL is not configured.", 5)
            return
        end

        -- =================================================
        -- CHECK DESCRIPTION
        -- =================================================

        local CleanText = BugDescription:gsub("%s+", "")

        if CleanText == "" then
            NotifyBugReport("Please describe the bug first.", 5)
            return
        end

        local Description = LimitUTF8(BugDescription, 4000)

        -- =================================================
        -- GET REQUEST FUNCTION
        -- =================================================

        local Request = GetRequestFunction()

        if type(Request) ~= "function" then
            warn("[Fack HUB] HTTP request is unavailable.")
            NotifyBugReport("HTTP request is unavailable.", 5)
            return
        end

        -- =================================================
        -- SERVICES
        -- =================================================

        local Players = game:GetService("Players")
        local HttpService = game:GetService("HttpService")
        local MarketplaceService = game:GetService("MarketplaceService")

        local LocalPlayer = Players.LocalPlayer

        if not LocalPlayer then
            NotifyBugReport("Unable to get local player.", 5)
            return
        end

        -- =================================================
        -- GAME INFORMATION
        -- =================================================

        local GameName = "Unknown"

        local GameInfoSuccess, GameInfo = pcall(function()
            return MarketplaceService:GetProductInfo(game.PlaceId)
        end)

        if GameInfoSuccess and GameInfo and GameInfo.Name then
            GameName = tostring(GameInfo.Name)
        end

        -- =================================================
        -- PLAYER COUNT
        -- =================================================

        local PlayerCount = #Players:GetPlayers()

        -- =================================================
        -- JOB ID AND JOIN CODE
        -- =================================================

        local CurrentJobId = tostring(game.JobId)
        local JoinJobCode = "Unavailable"

        if CurrentJobId ~= "" then
            JoinJobCode =
                'game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, "'
                .. CurrentJobId
                .. '", game.Players.LocalPlayer)'
        else
            CurrentJobId = "Unavailable"
        end

        -- =========================================================
        -- FACK HUB | BEAUTIFUL BUG REPORT EMBED
        -- =========================================================

        local Data = {
            username = "Fack HUB | Bug Reporter",

            allowed_mentions = {
                parse = {}
            },

            embeds = {{
                -- HEADER
                author = {
                    name = "FACK HUB  •  BUG REPORT SYSTEM"
                },

                title = "🐛  New Bug Report",

                description =
                    "A new bug report has been submitted.\n\n"
                    .. "📝 **Bug Description**\n"
                    .. "```text\n"
                    .. Description
                    .. "\n```",

                color = 0xFF4757,

                -- INFORMATION
                fields = {
                    {
                        name = "👤  PLAYER INFORMATION",
                        value =
                            "**Username**\n"
                            .. "`" .. tostring(LocalPlayer.Name) .. "`\n\n"
                            .. "**Display Name**\n"
                            .. tostring(LocalPlayer.DisplayName) .. "\n\n"
                            .. "**User ID**\n"
                            .. "`" .. tostring(LocalPlayer.UserId) .. "`",
                        inline = true
                    },

                    {
                        name = "🎮  GAME INFORMATION",
                        value =
                            "**Game Name**\n"
                            .. tostring(GameName) .. "\n\n"
                            .. "**Player Count**\n"
                            .. "👥 `" .. tostring(PlayerCount) .. "`\n\n"
                            .. "**Script Version**\n"
                            .. "`" .. tostring(ScriptVersion) .. "`",
                        inline = true
                    },

                    {
                        name = "🗺️  GAME IDENTIFIERS",
                        value =
                            "**Place ID**\n"
                            .. "`" .. tostring(game.PlaceId) .. "`\n\n"
                            .. "**Game ID**\n"
                            .. "`" .. tostring(game.GameId) .. "`",
                        inline = false
                    },

                    {
                        name = "🌐  SERVER INFORMATION",
                        value =
                            "**Job ID**\n"
                            .. "```text\n"
                            .. tostring(CurrentJobId)
                            .. "\n```\n"
                            .. "**Join Job ID Code**\n"
                            .. "```lua\n"
                            .. JoinJobCode
                            .. "\n```",
                        inline = false
                    }
                },

                -- FOOTER
                footer = {
                    text = "Fack HUB  •  Bug Reporter"
                },

                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        }

        -- =================================================
        -- ENCODE JSON
        -- =================================================

        local EncodeSuccess, Body = pcall(function()
            return HttpService:JSONEncode(Data)
        end)

        if not EncodeSuccess then
            warn("[Fack HUB] Failed to encode bug report.")
            NotifyBugReport("Failed to encode report.", 5)
            return
        end

        -- =================================================
        -- SEND WEBHOOK
        -- =================================================

        IsSendingBugReport = true

        NotifyBugReport("Sending bug report...", 3)

        local RequestSuccess, Response = pcall(function()
            return Request({
                Url = BugWebhookURL,

                Method = "POST",

                Headers = {
                    ["Content-Type"] = "application/json"
                },

                Body = Body
            })
        end)

        IsSendingBugReport = false

        -- =================================================
        -- REQUEST ERROR
        -- =================================================

        if not RequestSuccess then
            warn(
                "[Fack HUB] Webhook Request Error:",
                tostring(Response)
            )

            NotifyBugReport("Failed to send report. Please try again.", 5)
            return
        end

        -- =================================================
        -- CHECK RESPONSE
        -- =================================================

        local StatusCode
        local ResponseBody

        if type(Response) == "table" then
            StatusCode = Response.StatusCode
            ResponseBody = Response.Body
        end

        print(
            "[Fack HUB] Bug Report Status:",
            tostring(StatusCode)
        )

        -- =================================================
        -- SUCCESS
        -- =================================================

        if StatusCode == 200
            or StatusCode == 201
            or StatusCode == 202
            or StatusCode == 204
        then
            NotifyBugReport("Bug report sent successfully!", 4)

            BugDescription = ""
            pcall(function()
                BugInput:Set("")
            end)

        -- =================================================
        -- FAILED
        -- =================================================

        else
            warn(
                "[Fack HUB] Webhook Failed | Status:",
                tostring(StatusCode),
                "| Response:",
                tostring(ResponseBody)
            )

            NotifyBugReport(
                "Webhook failed. Status: " .. tostring(StatusCode),
                6
            )
        end
    end
})


