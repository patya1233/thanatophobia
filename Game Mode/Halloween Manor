-- Noclip Function
-- ==========================================
local FackNoclipEnabled = false
local FackNoclipConnection = nil
local FackNoclipOriginal = {}

-- เปิด Noclip
local function StartNoclip()
    if FackNoclipEnabled then
        return
    end

    FackNoclipEnabled = true

    FackNoclipConnection = RunService.Stepped:Connect(function()
        pcall(function()
            if not character then
                return
            end

            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then

                    if FackNoclipOriginal[part] == nil then
                        FackNoclipOriginal[part] = part.CanCollide
                    end

                    part.CanCollide = false
                end
            end
        end)
    end)
end

-- ปิด Noclip
local function StopNoclip()
    FackNoclipEnabled = false

    if FackNoclipConnection then
        FackNoclipConnection:Disconnect()
        FackNoclipConnection = nil
    end

    -- คืนค่า CanCollide เดิม
    for part, originalValue in pairs(FackNoclipOriginal) do
        pcall(function()
            if part.Parent then
                part.CanCollide = originalValue
            end
        end)

        FackNoclipOriginal[part] = nil
    end
end

local HamTab = Window:CreateTab("ZombieMan", "align-justify")

local Section = HamTab:CreateSection("Part 1")

local Button = HamTab:CreateButton({
    Name = "Auto Win",

    Callback = function()

        SaveCFrame()

        local cutscene = workspace.MainPuzzle:WaitForChild("GateCutsceneStuff"):WaitForChild("CutsceneEnded")
        local MonsterPath = workspace:FindFirstChild("Monsters", true)
        local MonsterDistance = 30


        pcall(function()

            TeleportTo(workspace.MainPuzzle.GateCutsceneStuff.GatePartTrigger)
            repeat
                task.wait()
            until cutscene.Value == true
            task.wait(3)
            TeleportTo(workspace.Dialogue.GateKeyObjective)
        end)

        StartFloat()

        for _, v in ipairs(workspace.MainPuzzle:GetChildren()) do

            if v:IsA("Part") and v.Name:find("Key") then

                -- มอนอยู่ใกล้ → กลับจุดเดิมและรอ
                while MonsterPath
                    and IsMonsterNear(
                        MonsterPath,
                        v,
                        MonsterDistance
                    ) do

                    ReturnCFrame()
                    task.wait(0.2)
                end

                -- มอนออกแล้ว → วาปไปเก็บ
                TeleportTo(v)
                task.wait(0.3)

                -- เช็กมอนอีกครั้งหลังวาป
                if MonsterPath
                    and IsMonsterNear(
                        MonsterPath,
                        v,
                        MonsterDistance
                    ) then

                    ReturnCFrame()

                    repeat
                        task.wait(0.2)
                    until not IsMonsterNear(
                        MonsterPath,
                        v,
                        MonsterDistance
                    )

                    TeleportTo(v)
                    task.wait(0.3)
                end

                local pp = v

                local prompt =
                    pp:FindFirstChildWhichIsA(
                        "ProximityPrompt",
                        true
                    )
                    or (
                        pp.Parent
                        and pp.Parent:FindFirstChildWhichIsA(
                            "ProximityPrompt",
                            true
                        )
                    )

                if prompt then
                    InteractPrompt(prompt, 0)
                end
            end
        end
        for _, v in ipairs(workspace.MainPuzzle:GetChildren()) do
            if v:IsA("Model") and v.Name == "Gate" then
                TeleportTo(v)
                task.wait(0.3)

                for i = 1, 5 do
                    local lock = v:FindFirstChild("Lock" .. i)

                    if lock then
                        local prompt = lock:FindFirstChildWhichIsA("ProximityPrompt", true)

                        if prompt then
                            InteractPrompt(prompt, 0)
                            task.wait(0.1)
                        end
                    end
                end
            end
        end

        StartNoclip()
        TweenTo(workspace.MainPuzzle.EndingTrigger, 100)
        StopNoclip()
        StopFloat()
    end,
})

