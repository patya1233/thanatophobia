local beTab = Window:CreateTab("BossFight", "align-justify")

local Section = beTab:CreateSection("Part 3")

local StunOrbEnabled = false
local StunOrbLoopId = 0
local StunOrbFloor = nil

local Toggle = beTab:CreateToggle({
    Name = "Auto BossFight",
    CurrentValue = false,
    Flag = "AutoStunOrbToggle",

    Callback = function(Value)

        StunOrbEnabled = Value
        StunOrbLoopId += 1

        local LoopId = StunOrbLoopId

        -- ==========================================
        -- STOP
        -- ==========================================
        if not Value then
            StopNoclip()
            StopFloat()

            pcall(function()
                if StunOrbFloor then
                    StunOrbFloor:Destroy()
                    StunOrbFloor = nil
                end

                local oldFloor = workspace:FindFirstChild("Fack hub")
                if oldFloor then
                    oldFloor:Destroy()
                end

                ReturnCFrame()
            end)

            return
        end

        -- ==========================================
        -- START
        -- ==========================================
        SaveCFrame()

        StartFloat()
        StartNoclip()

        task.spawn(function()

            local Success, ErrorMessage = pcall(function()

                -- ==========================================
                -- SEARCH POSITION
                -- ห่าง 2000 studs สูงขึ้น 100 studs
                -- ==========================================
                character = player.Character
                    or player.CharacterAdded:Wait()

                hrp = character:WaitForChild("HumanoidRootPart")

                local SearchCFrame =
                    hrp.CFrame * CFrame.new(0, 100, 2000)

                -- ==========================================
                -- CREATE FLOOR
                -- ==========================================
                local oldFloor = workspace:FindFirstChild("Fack hub")

                if oldFloor then
                    oldFloor:Destroy()
                end

                StunOrbFloor = Instance.new("Part")
                StunOrbFloor.Name = "Fack hub"
                StunOrbFloor.Size = Vector3.new(10, 1, 10)
                StunOrbFloor.Anchored = true
                StunOrbFloor.CanCollide = true
                StunOrbFloor.Transparency = 0.2
                StunOrbFloor.Material = Enum.Material.SmoothPlastic

                StunOrbFloor.CFrame = CFrame.new(
                    SearchCFrame.Position.X,
                    SearchCFrame.Position.Y - 3.5,
                    SearchCFrame.Position.Z
                )

                StunOrbFloor.Parent = workspace

                if not StunOrbEnabled or LoopId ~= StunOrbLoopId then
                    return
                end

                -- วาปไปจุดรอ
                TeleportTo(SearchCFrame)
                task.wait(0.2)

                -- ==========================================
                -- GET STUNORB
                -- ==========================================
                local function GetStunOrb()
                    local folder = workspace:FindFirstChild("Folder")

                    if not folder then
                        return nil
                    end

                    return folder:FindFirstChild("StunOrb")
                end

                -- ==========================================
                -- GET ORB PART
                -- ==========================================
                local function GetOrbPart(orb)
                    if orb:IsA("BasePart") then
                        return orb
                    elseif orb:IsA("Model") then
                        return orb.PrimaryPart
                            or orb:FindFirstChildWhichIsA(
                                "BasePart",
                                true
                            )
                    end

                    return nil
                end

                -- ==========================================
                -- MAIN LOOP
                -- ==========================================
                while StunOrbEnabled and LoopId == StunOrbLoopId do

                    -- รอจนกว่า StunOrb จะปรากฏ
                    local orb = GetStunOrb()

                    if not orb then
                        task.wait(0.1)
                        continue
                    end

                    -- ==========================================
                    -- INTERACT WITH STUNORB
                    -- ==========================================
                    while StunOrbEnabled
                        and LoopId == StunOrbLoopId
                        and orb.Parent do

                        local part = GetOrbPart(orb)

                        if not part then
                            task.wait(0.1)
                            continue
                        end

                        -- วาปไปเหนือ StunOrb 18 studs
                        TeleportTo(
                            part.Position + Vector3.new(0, 18, 0)
                        )

                        task.wait(0.1)

                        if not StunOrbEnabled
                            or LoopId ~= StunOrbLoopId then
                            break
                        end

                        if not orb.Parent then
                            break
                        end

                        -- หา ProximityPrompt
                        local prompt =
                            orb:FindFirstChildWhichIsA(
                                "ProximityPrompt",
                                true
                            )

                        if not prompt and orb.Parent then
                            prompt =
                                orb.Parent:FindFirstChildWhichIsA(
                                    "ProximityPrompt",
                                    true
                                )
                        end

                        -- กดซ้ำจนกว่า StunOrb จะหาย
                        if prompt then
                            InteractPrompt(prompt, 0)
                        end

                        task.wait(0.1)
                    end

                    -- ==========================================
                    -- STUNORB DISAPPEARED
                    -- วาปกลับจุดรอเดิม
                    -- ==========================================
                    if StunOrbEnabled and LoopId == StunOrbLoopId then
                        TeleportTo(SearchCFrame)
                        task.wait(0.1)
                    end
                end
            end)

            -- ==========================================
            -- ERROR HANDLING
            -- ==========================================
            if not Success then
                warn("[Auto BossFight] Error: " .. tostring(ErrorMessage))
            end

            if LoopId == StunOrbLoopId then
                StunOrbEnabled = false

                StopNoclip()
                StopFloat()

                pcall(function()
                    if StunOrbFloor then
                        StunOrbFloor:Destroy()
                        StunOrbFloor = nil
                    end

                    local oldFloor = workspace:FindFirstChild("Fack hub")
                    if oldFloor then
                        oldFloor:Destroy()
                    end

                    ReturnCFrame()
                end)
            end
        end)
    end,
})
