local beTab = Window:CreateTab("Orb", "align-justify")

local Section = beTab:CreateSection("Part 2")

local Button = beTab:CreateButton({
    Name = "Auto Collect Orb",

    Callback = function()

        SaveCFrame()

        local Puzzle = workspace.SecondSection.Puzzle2
        local OrbsCollected = Puzzle:WaitForChild("OrbsCollected")
        local OrbsCollected2 = Puzzle:WaitForChild("OrbsCollected2")

        local MonsterPath = workspace:FindFirstChild("Monster1", true)
        local MonsterDistance = 30

        pcall(function()
            TeleportTo(workspace.Dialogue.Objective2)
            task.wait(0.5)
            ReturnCFrame()
            task.wait(3)
        end)

        StartFloat()

        -- =========================================
        -- FUNCTION: COLLECT ORB
        -- =========================================

        local function CollectOrbRound(OrbFolder, Counter)

            while Counter.Value < 12 do

                for _, v in ipairs(OrbFolder:GetChildren()) do

                    if Counter.Value >= 12 then
                        break
                    end

                    if v.Name == "Orb" then

                        -- รอจนกว่า Monster จะออกห่าง
                        while Counter.Value < 12
                            and MonsterPath
                            and v.Parent
                            and IsMonsterNear(
                                MonsterPath,
                                v,
                                MonsterDistance
                            ) do

                            ReturnCFrame()
                            task.wait(0.2)
                        end

                        if Counter.Value >= 12 then
                            break
                        end

                        if v.Parent then

                            TeleportTo(v)
                            task.wait(0.3)

                            -- ตรวจสอบ Monster หลังวาป
                            if Counter.Value < 12
                                and MonsterPath
                                and IsMonsterNear(
                                    MonsterPath,
                                    v,
                                    MonsterDistance
                                ) then

                                ReturnCFrame()

                                repeat
                                    task.wait(0.2)
                                until Counter.Value >= 12
                                    or not IsMonsterNear(
                                        MonsterPath,
                                        v,
                                        MonsterDistance
                                    )

                                if Counter.Value < 12
                                    and v.Parent then

                                    TeleportTo(v)
                                    task.wait(0.3)
                                end
                            end

                            -- ค้นหา ProximityPrompt
                            if Counter.Value < 12 and v.Parent then

                                local prompt =
                                    v:FindFirstChildWhichIsA(
                                        "ProximityPrompt",
                                        true
                                    )
                                    or (
                                        v.Parent
                                        and v.Parent:FindFirstChildWhichIsA(
                                            "ProximityPrompt",
                                            true
                                        )
                                    )

                                if prompt then
                                    InteractPrompt(prompt, 0)
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end

                if Counter.Value < 12 then
                    task.wait(0.2)
                end
            end
        end

        -- =========================================
        -- ROUND 1: PUZZLE2
        -- =========================================

        while OrbsCollected.Value < 12 do
            pcall(function()
                CollectOrbRound(Puzzle, OrbsCollected)
            end)

            task.wait(0.2)
        end

        -- รอบแรกครบ 12 กลับจุดเดิม
        ReturnCFrame()
        task.wait(0.5)

        -- =========================================
        -- WAIT FOR SECONDROUND
        -- =========================================

        local SecondRound = Puzzle:FindFirstChild("SecondRound")

        while not SecondRound do
            task.wait(0.2)
            SecondRound = Puzzle:FindFirstChild("SecondRound")
        end

        -- =========================================
        -- ROUND 2: SECONDROUND
        -- =========================================

        while OrbsCollected2.Value < 12 do
            pcall(function()
                CollectOrbRound(SecondRound, OrbsCollected2)
            end)

            task.wait(0.2)
        end

        -- =========================================
        -- COMPLETED: CONTINUE
        -- =========================================

        TeleportTo(workspace.Cutscene2Trigger)
        StopFloat()

    end,
})

