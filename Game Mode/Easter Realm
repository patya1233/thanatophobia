local Button = eaTab:CreateButton({
    Name = "Auto Eggs Code",

    Callback = function()
        local Part2 = workspace.MainPuzzle.Part2
        local Code = Part2.Code
        local StonePillars = Code.StonePillars

        local Colors = {
            "Blue",
            "Green",
            "Red",
            "White"
        }

        local function CountEggs(folder)
            local count = 0

            for _, egg in ipairs(folder:GetChildren()) do
                if egg.Name == "Egg" then
                    count += 1
                end
            end

            return count
        end

        for _, color in ipairs(Colors) do
            local eggFolder = Code:FindFirstChild(color .. "Eggs")
            local codeValue = Code:FindFirstChild(color .. "Code")
            local pillar = StonePillars:FindFirstChild(color)

            if eggFolder and codeValue and pillar then
                local eggCount = CountEggs(eggFolder)
                local main = pillar:FindFirstChild("Main")
                local prompt = main and main:FindFirstChildWhichIsA(
                    "ProximityPrompt",
                    true
                )

                if main and prompt then
                    -- print(color, "จำนวนไข่:", eggCount, "ค่าปัจจุบัน:", codeValue.Value)

                    -- วาปไปหาเสาสีนี้ก่อน หากค่าปัจจุบันยังไม่ตรง
                    if codeValue.Value < eggCount then
                        local targetPosition = main.CFrame * CFrame.new(0, 0, -3)
                        StartFloat()
                        TeleportTo(targetPosition)
                        task.wait(0.3)
                    end

                    -- กดจนกว่า Value จะเท่ากับจำนวนไข่
                    while codeValue.Value < eggCount do
                        local oldValue = codeValue.Value

                        InteractPrompt(prompt, 0.3)

                        -- รอจนค่าเปลี่ยน เพื่อไม่ให้กดซ้ำเร็วเกินไป
                        local startTime = os.clock()

                        repeat
                            task.wait(0.1)
                        until codeValue.Value ~= oldValue
                            or os.clock() - startTime >= 3

                        -- ป้องกันลูปไม่รู้จบหากค่าของปุ่มไม่เปลี่ยน
                        if codeValue.Value == oldValue then
                            warn(color .. " ค่าไม่เปลี่ยน หยุดการกด")
                            break
                        end
                    end

                    if codeValue.Value == eggCount then
                        -- print(color .. " สำเร็จ! Value =", codeValue.Value)
                        StopFloat()
                    elseif codeValue.Value > eggCount then
                        warn(color .. " ค่าเกินจำนวนไข่")
                    end

                    task.wait(0.3)
                else
                    warn("ไม่พบ Main หรือ ProximityPrompt ของสี " .. color)
                end
            else
                warn("ไม่พบโฟลเดอร์หรือ Value ของสี " .. color)
            end
        end
    end,
})

