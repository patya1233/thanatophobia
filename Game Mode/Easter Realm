-- ===== บินวนเป็นสี่เหลี่ยม =====
-- half = ครึ่งหนึ่งของด้านสี่เหลี่ยม (studs), speed = ความเร็ว (studs/วินาที)
local function squareOffset(elapsed, half, speed)
    half = math.max(half, 0.5)
    local side = half * 2
    local s = (elapsed * speed) % (side * 4)
    local idx = math.floor(s / side)
    local along = s - idx * side
    if idx == 0 then
        return Vector3.new(-half + along, 0, -half)
    elseif idx == 1 then
        return Vector3.new(half, 0, -half + along)
    elseif idx == 2 then
        return Vector3.new(half - along, 0, half)
    else
        return Vector3.new(-half, 0, half - along)
    end
end

-- ===== ฟังก์ชันพื้นฐาน =====
local function isAlive(model)
    if not (model and model.Parent) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health > 0 end
    return true
end

local function getRoot(model)
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function findTarget()
    local ok, obj = pcall(Config.GetTarget)
    if ok and typeof(obj) == "Instance" and obj:IsA("Model") and isAlive(obj) then
        return obj
    end
    return nil
end

local function findMinion()
    if not Config.MinionsEnabled then return nil end
    if isAlive(currentMinion) then return currentMinion end

    local ok, folder = pcall(Config.GetMinionsFolder)
    if not (ok and typeof(folder) == "Instance") then return nil end

    local best, bestDist
    for _, obj in ipairs(folder:GetChildren()) do
        if obj:IsA("Model") and isAlive(obj) then
            local root = getRoot(obj)
            if root then
                local d = (root.Position - hrp.Position).Magnitude
                if not bestDist or d < bestDist then
                    best, bestDist = obj, d
                end
            end
        end
    end
    currentMinion = best
    return best
end

