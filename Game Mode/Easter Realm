local Templates = {} -- [ชื่อปืน] = {args, muzzle, remoteName}
local firingByUs = false

local function getMuzzle(tool)
    local p = tool:FindFirstChild("ShootPart") or tool:FindFirstChild("Handle")
    return p and p:IsA("BasePart") and p.Position or nil
end

if hookmetamethod and getnamecallmethod then
    local old
    local function hook(self, ...)
        if getnamecallmethod() == "FireServer"
            and not firingByUs
            and not (checkcaller and checkcaller())
            and typeof(self) == "Instance" and self:IsA("RemoteEvent")
            and self.Name == Config.FireRemoteName then

            local args = table.pack(...)
            pcall(function()
                local tool = self:FindFirstAncestorWhichIsA("Tool")
                if tool then
                    local first = not Templates[tool.Name]
                    Templates[tool.Name] = {
                        args = args,
                        muzzle = getMuzzle(tool) or hrp.Position,
                        remoteName = self.Name,
                    }
                    if first then
                        print("[เรียนรู้] ปืน '" .. tool.Name .. "' จำนวนอาร์กิวเมนต์ = " .. args.n)
                        for i = 1, args.n do
                            print("   ", i, typeof(args[i]), tostring(args[i]))
                        end
                    end
                end
            end)
        end
        return old(self, ...)
    end
    old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
else
    warn("Executor ไม่รองรับ hookmetamethod จะใช้วิธีหันกล้อง+คลิกแทน")
end

-- สร้างอาร์กิวเมนต์ใหม่จากนัดที่เรียนรู้ โดยแทนที่ค่าที่เป็นตำแหน่ง/เป้าหมาย
local function buildArgs(tpl, target, muzzleNow)
    local root = getRoot(target)
    if not root then return nil end

    local aimPart = root
    for i = 1, tpl.args.n do
        local v = tpl.args[i]
        if typeof(v) == "Instance" and v:IsA("BasePart") and not v:IsDescendantOf(character) then
            aimPart = target:FindFirstChild(v.Name, true) or root
            break
        end
    end
    local aimPos = aimPart.Position + Config.AimOffset

    local out = {}
    for i = 1, tpl.args.n do
        local v = tpl.args[i]
        local t = typeof(v)

        if t == "Vector3" then
            if (v - tpl.muzzle).Magnitude <= 6 then
                out[i] = muzzleNow                               -- จุดเริ่มกระสุน
            elseif math.abs(v.Magnitude - 1) < 0.02 then
                out[i] = (aimPos - muzzleNow).Unit               -- ทิศทาง
            else
                out[i] = aimPos                                  -- จุดที่โดน
            end
        elseif t == "CFrame" then
            if (v.Position - tpl.muzzle).Magnitude <= 6 then
                out[i] = CFrame.lookAt(muzzleNow, aimPos)
            else
                out[i] = CFrame.new(aimPos)
            end
        elseif t == "Instance" then
            if v:IsA("BasePart") and not v:IsDescendantOf(character) then
                out[i] = aimPart
            elseif v:IsA("Humanoid") and not v:IsDescendantOf(character) then
                out[i] = target:FindFirstChildOfClass("Humanoid") or v
            elseif v:IsA("Model") and v ~= character then
                out[i] = target
            else
                out[i] = v
            end
        else
            out[i] = v
        end
    end
    return out
end

local function fireRemote(tool, target)
    local tpl = Templates[tool.Name]
    if not tpl then return false end
    local remote = tool:FindFirstChild(tpl.remoteName)
    if not (remote and remote:IsA("RemoteEvent")) then return false end

    local muzzleNow = getMuzzle(tool) or hrp.Position
    local args = buildArgs(tpl, target, muzzleNow)
    if not args then return false end

    firingByUs = true
    local ok = pcall(function()
        remote:FireServer(table.unpack(args, 1, tpl.args.n))
    end)
    firingByUs = false
    return ok
end

-- ===== รีโหลด: คลิก + กดปุ่ม (เปิด/ปิดแยกกันได้) =====
local reloadStart = 0
local lastReloadFire = 0

-- คืน true ถ้ากำลังรีโหลดอยู่ (ให้หยุดยิงรีโมทไว้ก่อน)
local function handleReload(tool)
    local ammo = tool:FindFirstChild("Ammo")
    if not (ammo and (ammo:IsA("IntValue") or ammo:IsA("NumberValue"))) then return false end
    if Config.DebugReload then print("[Reload] Ammo =", ammo.Value) end

    if ammo.Value > 0 then
        reloadStart = 0
        return false
    end

    if reloadStart == 0 then reloadStart = tick() end

    if tick() - reloadStart > Config.ReloadTimeout then
        return false
    end

    if tick() - lastReloadFire > Config.ReloadInterval then
        lastReloadFire = tick()

        if Config.ReloadByClick then
            local size = camera.ViewportSize
            local center = Vector2.new(size.X / 2, size.Y / 2)
            pcall(function() tool:Activate() end)
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(center, camera.CFrame)
            task.wait(0.05)
            VirtualUser:Button1Up(center, camera.CFrame)
        end

        if Config.ReloadByKey and keypress and keyrelease then
            pcall(keypress, Config.ReloadKey)
            task.wait(0.05)
            pcall(keyrelease, Config.ReloadKey)
        end
    end

    return true
end

