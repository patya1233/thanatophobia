-- ===== ถือไอเท็ม =====
local function equipTool()
    local name = currentToolName()
    if name == "" then return nil end
    if not (character and character.Parent and humanoid and humanoid.Health > 0) then return nil end

    local held = character:FindFirstChild(name)
    if held and held:IsA("Tool") then return held end

    local backpack = player:FindFirstChildOfClass("Backpack")
    local tool = backpack and backpack:FindFirstChild(name)

    if not (tool and tool:IsA("Tool")) then
        if tick() - lastWarn > 3 then
            lastWarn = tick()
            local names = {}
            if backpack then
                for _, t in ipairs(backpack:GetChildren()) do
                    table.insert(names, t.Name)
                end
            end
            warn("ไม่เจอไอเท็ม '" .. name .. "' ใน Backpack มี: " .. table.concat(names, ", "))
        end
        return nil
    end

    humanoid:EquipTool(tool)
    task.wait()
    if tool.Parent ~= character then
        tool.Parent = character
    end
    return tool.Parent == character and tool or nil
end

