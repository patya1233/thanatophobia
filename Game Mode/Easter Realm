local function getBossAnimator()
    if not currentTarget then return nil end
    if bossAnimator and bossAnimator:IsDescendantOf(currentTarget) then
        return bossAnimator
    end
    bossAnimator = currentTarget:FindFirstChildWhichIsA("Animator", true)
    return bossAnimator
end

local function bossStartedDodgeAnim()
    local animator = getBossAnimator()
    if not animator then return nil end

    for track in pairs(seenTracks) do
        if not track.IsPlaying then seenTracks[track] = nil end
    end

    local result
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if not seenTracks[track] then
            seenTracks[track] = true
            local id = string.match(tostring(track.Animation and track.Animation.AnimationId or ""), "%d+")

            if Config.DebugAnims then
                print(("[Boss Anim] ID=%s | Name=%s | Looped=%s | Length=%.2f")
                    :format(tostring(id), track.Name, tostring(track.Looped), track.Length))
            end

            local info = id and Config.DodgeAnims and Config.DodgeAnims[id]
            if info and (not result or info.time > result.time) then
                result = info
            end
        end
    end
    return result
end

-- ===== เริ่ม/หยุด =====
local function stopFarm()
    if not farming then return end
    farming = false
    healing = false
    dodging = false
    healPos = nil
    dodgePos = nil
    dodgeUntil = 0
    currentTarget = nil
    currentMinion = nil
    fightTarget = nil
    fightIsMinion = false
    bossAnimator = nil
    reloadStart = 0
    table.clear(seenTracks)
    if heartbeatConn then
        heartbeatConn:Disconnect()
        heartbeatConn = nil
    end
    pcall(function() VirtualUser:Button1Up(Vector2.new(0, 0), camera.CFrame) end)
end

local function startFarm()
    if farming then return end
    farming = true
    currentTarget = findTarget()

    -- ลูปถือไอเท็ม
    task.spawn(function()
        while farming do
            equipTool()
            task.wait(0.2)
        end
    end)

    -- ลูปยิง/ต่อย (ไม่ทำตอนรีเลือดหรือหลบ)
    task.spawn(function()
        while farming do
            if fightTarget and isAlive(fightTarget) and not healing and not dodging then
                local name = currentToolName()
                local tool = name ~= "" and character and character:FindFirstChild(name) or nil
                if tool and not tool:IsA("Tool") then tool = nil end

                if name == "" or tool then
                    local reloading = tool and Config.AutoReload and handleReload(tool)

                    if not reloading then
                        local fired = false
                        if tool and Config.UseRemoteFire then
                            fired = fireRemote(tool, fightTarget)
                        end

                        if not fired then
                            local cp = getClickPos()
                            if Config.UseActivate and tool then
                                pcall(function() tool:Activate() end)
                            end
                            VirtualUser:CaptureController()
                            VirtualUser:Button1Down(cp, camera.CFrame)
                            task.wait(0.02)
                            VirtualUser:Button1Up(cp, camera.CFrame)
                        end
                    end
                end
            end
            task.wait(math.max(1 / Config.ClicksPerSec - 0.02, 0.01))
        end
    end)

    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not (hrp and hrp.Parent and humanoid and humanoid.Health > 0) then
            healing = false
            dodging = false
            healPos = nil
            dodgePos = nil
            fightTarget = nil
            return
        end

        -- ===== 1) รีเลือด (สำคัญสุด) =====
        local recover = math.max(Config.RecoverHP, Config.LowHP + 1)
        if healing then
            if humanoid.Health >= recover then
                healing = false
                healPos = nil
            end
        elseif humanoid.Health < Config.LowHP then
            healing = true
            dodging = false
            dodgePos = nil
            healPos = hrp.Position + Vector3.new(0, Config.SafeHeight, 0)
            healStart = tick()
            warn(("รีเลือด: HP %.0f / %.0f"):format(humanoid.Health, humanoid.MaxHealth))
        end

        if healing then
            local pos = healPos
            if Config.HealOrbit then
                pos = healPos + squareOffset(tick() - healStart, Config.HealOrbitSize, Config.HealOrbitSpeed)
            end
            hrp.CFrame = CFrame.new(pos)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            return
        end

        -- ===== หาบอส =====
        if not isAlive(currentTarget) then
            currentTarget = nil
            bossAnimator = nil
            table.clear(seenTracks)
            if tick() - lastSearch > 0.5 then
                lastSearch = tick()
                currentTarget = findTarget()
            end
        end

        -- ===== 2) หลบ =====
        -- 2a) มีของโผล่ใน AttackFolder: เริ่มหลบ (ถ้ายังไม่ได้หลบ) และต่อเวลาไปเรื่อยๆ
        if attackPresent() then
            if not dodging then
                dodging = true
                dodgeStart = tick()
                dodgePos = hrp.Position + Vector3.new(0, Config.AttackHeight, 0)
            end
            dodgeUntil = math.max(dodgeUntil, tick() + Config.AttackLinger)
        end

        -- 2b) ท่าอนิเมชันของบอส
        if Config.DodgeEnabled and currentTarget and not dodging then
            local info = bossStartedDodgeAnim()
            if info then
                dodging = true
                dodgeUntil = tick() + info.time
                dodgeStart = tick()
                dodgePos = hrp.Position + Vector3.new(0, info.height, 0)
            end
        end

        if dodging and tick() >= dodgeUntil then
            dodging = false
            dodgePos = nil
        end

        if dodging then
            local pos = dodgePos
            if Config.DodgeOrbit then
                pos = dodgePos + squareOffset(tick() - dodgeStart, Config.DodgeOrbitSize, Config.DodgeOrbitSpeed)
            end
            hrp.CFrame = CFrame.new(pos)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            return
        end

        -- ===== 3) เลือกเป้าหมาย: มินเนี่ยนก่อน ไม่มีค่อยบอส =====
        local minion = findMinion()
        fightIsMinion = minion ~= nil
        fightTarget = minion or currentTarget
        if not fightTarget then return end

        local root = getRoot(fightTarget)
        if not root then return end

        local dist = fightIsMinion and Config.MinionDist or Config.BehindDist
        local targetPos = root.Position
        local pos = (root.CFrame * CFrame.new(0, 0, dist)).Position

        hrp.CFrame = CFrame.lookAt(pos, Vector3.new(targetPos.X, pos.Y, targetPos.Z))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPos + Config.AimOffset)
    end)
end

