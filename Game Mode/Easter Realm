local function CreateESPBox(object, color, size, transparency)
    if not object then
        return nil
    end

    color = color or Color3.fromRGB(0, 255, 0)
    transparency = transparency or 0.5

    -- Part / MeshPart / UnionOperation ฯลฯ
    if object:IsA("BasePart") then
        if object:FindFirstChild("FackhubBox") then
            return nil
        end

        local box = Instance.new("BoxHandleAdornment")
        box.Name = "FackhubBox"
        box.Adornee = object
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Size = size or object.Size
        box.Color3 = color
        box.Transparency = transparency
        box.Parent = object

        return box
    end

    -- Model
    if object:IsA("Model") then
        local part = object:FindFirstChild("HumanoidRootPart")
            or object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)

        if not part then
            warn("ไม่พบ BasePart ใน Model:", object:GetFullName())
            return nil
        end

        if part:FindFirstChild("FackhubBox") then
            return nil
        end

        local box = Instance.new("BoxHandleAdornment")
        box.Name = "FackhubBox"
        box.Adornee = part
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Size = size or part.Size
        box.Color3 = color
        box.Transparency = transparency
        box.Parent = part

        return box
    end

    return nil
end

local function InteractPrompt(object, delayTime)
    if not object then
        return
    end

    if delayTime and delayTime > 0 then
        task.wait(delayTime)
    end

    local prompts = {}

    -- ถ้า object เองเป็น ProximityPrompt
    if object:IsA("ProximityPrompt") then
        table.insert(prompts, object)
    end

    -- หา ProximityPrompt ทุกตัวที่อยู่ข้างใน object
    for _, v in ipairs(object:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            table.insert(prompts, v)
        end
    end

    -- กดทุก Prompt ที่เจอ
    for _, prompt in ipairs(prompts) do
        pcall(function()
            prompt.Enabled = true
            fireproximityprompt(prompt)
        end)
    end
end

local function TeleportTo(targetPosition)
    if not hrp or not targetPosition then
        return
    end

    if typeof(targetPosition) == "CFrame" then
        hrp.CFrame = targetPosition

    elseif typeof(targetPosition) == "Vector3" then
        hrp.CFrame = CFrame.new(targetPosition)

    elseif typeof(targetPosition) == "Instance" then

        if targetPosition:IsA("BasePart") then
            hrp.CFrame = targetPosition.CFrame

        elseif targetPosition:IsA("Model") then
            local root = targetPosition:FindFirstChild("HumanoidRootPart")
                or targetPosition.PrimaryPart
                or targetPosition:FindFirstChildWhichIsA("BasePart", true)

            if root then
                hrp.CFrame = root.CFrame
            end
        end
    end
end

local function TeleportToNearestSafeLight(folder)
    local nearest = nil
    local shortest = math.huge

    for _, v in ipairs(folder:GetChildren()) do
        local targetPosition

        if v:IsA("BasePart") then
            targetPosition = v.Position

        elseif v:IsA("Model") then
            targetPosition = v:GetPivot().Position
        end

        if targetPosition then
            local distance = (hrp.Position - targetPosition).Magnitude

            if distance < shortest then
                shortest = distance
                nearest = v
            end
        end
    end

    if nearest then
        TeleportTo(nearest)
    end
end

