-- Noclip Function
-- ==========================================
local FackNoclipEnabled = false
local FackNoclipConnection = nil
local FackNoclipOriginal = {}

-- เปิด Noclip
local function StartNoclip()
    if FackNoclipEnabled then
        return
    end

    FackNoclipEnabled = true

    FackNoclipConnection = RunService.Stepped:Connect(function()
        pcall(function()
            if not character then
                return
            end

            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then

                    if FackNoclipOriginal[part] == nil then
                        FackNoclipOriginal[part] = part.CanCollide
                    end

                    part.CanCollide = false
                end
            end
        end)
    end)
end

-- ปิด Noclip
local function StopNoclip()
    FackNoclipEnabled = false

    if FackNoclipConnection then
        FackNoclipConnection:Disconnect()
        FackNoclipConnection = nil
    end

    -- คืนค่า CanCollide เดิม
    for part, originalValue in pairs(FackNoclipOriginal) do
        pcall(function()
            if part.Parent then
                part.CanCollide = originalValue
            end
        end)

        FackNoclipOriginal[part] = nil
    end
end

local function TeleportWhenMoved(Monster, Target, Threshold)
    Threshold = Threshold or 0.05

    local function GetPosition(Object)
        if Object:IsA("BasePart") then
            return Object.Position
        elseif Object:IsA("Model") then
            return Object:GetPivot().Position
        end
        return nil
    end

    if not Monster or not Target then
        warn("Monster or Target not found")
        return
    end

    local StartPosition = GetPosition(Monster)
    if not StartPosition then
        warn("Cannot detect Monster position")
        return
    end

    local Connection
    Connection = RunService.Heartbeat:Connect(function()
        if not Monster.Parent then
            Connection:Disconnect()
            return
        end

        local CurrentPosition = GetPosition(Monster)
        if not CurrentPosition then return end

        if (CurrentPosition - StartPosition).Magnitude >= Threshold then
            Connection:Disconnect()
            TeleportTo(Target)
        end
    end)

    return Connection
end

local function TeleportUntilWreathStops(v)
    local wreath = workspace.Monsters:WaitForChild("Wreath")

    local interval = 0.15
    local stillTime = 0
    local lastPosition

    if wreath:IsA("Model") then
        lastPosition = wreath:GetPivot().Position
    elseif wreath:IsA("BasePart") then
        lastPosition = wreath.Position
    else
        return
    end

    while wreath.Parent do
        local targetCFrame

        if v:IsA("Model") then
            targetCFrame = v:GetPivot()
        elseif v:IsA("BasePart") then
            targetCFrame = v.CFrame
        end

        if not targetCFrame then
            break
        end

        TeleportTo(targetCFrame)
        task.wait(interval)

        local currentPosition

        if wreath:IsA("Model") then
            currentPosition = wreath:GetPivot().Position
        elseif wreath:IsA("BasePart") then
            currentPosition = wreath.Position
        end

        if not currentPosition then
            break
        end

        if (currentPosition - lastPosition).Magnitude < 0.05 then
            stillTime = stillTime + interval
        else
            stillTime = 0
        end

        if stillTime >= 1 then
            break
        end

        lastPosition = currentPosition
    end
end

